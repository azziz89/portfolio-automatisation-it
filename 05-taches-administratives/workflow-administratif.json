      },
      "name": "Lire les echeances",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst today = new Date(); today.setHours(0, 0, 0, 0);\nconst late = [], urgent = [], soon = [];\nfor (const r of rows) {\n  if (!r.Element || !r.DateEcheance) continue;\n  if (String(r.Statut || '').toLowerCase().startsWith('fait')) continue;\n  const d = new Date(r.DateEcheance);\n  if (isNaN(d)) continue;\n  const days = Math.round((d - today) / 86400000);\n  const line = '• ' + r.Element + ' - ' + (r.Responsable || '?') + ' - ' + Number(r.Montant || 0).toLocaleString('fr-FR') + ' Ar';\n  if (days < 0) late.push(line + ' (retard ' + (-days) + ' j)');\n  else if (days <= 7) urgent.push(line + ' (dans ' + days + ' j)');\n  else if (days <= 30) soon.push(line + ' (dans ' + days + ' j)');\n}\nconst parts = [];\nif (late.length) parts.push('🔴 EN RETARD\\n' + late.join('\\n'));\nif (urgent.length) parts.push('🟠 URGENT (7 jours)\\n' + urgent.join('\\n'));\nif (soon.length) parts.push('🟡 A PREVOIR (30 jours)\\n' + soon.join('\\n'));\nif (!parts.length) return [];\nreturn [{ json: { message: '📋 Echeances du ' + today.toLocaleDateString('fr-FR') + '\\n\\n' + parts.join('\\n\\n') } }];"
      },
      "name": "Calculer les echeances",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        240
      ]
    },
