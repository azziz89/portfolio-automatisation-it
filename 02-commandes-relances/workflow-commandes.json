    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst qte = Number(d['Quantité']);\nconst pu = Number(d['Prix unitaire (Ar)']);\nconst iso = new Date().toISOString().slice(0, 10);\nconst num = 'CMD-' + iso.replace(/-/g, '') + '-' + String(Math.floor(Math.random() * 9000) + 1000);\nreturn [{ json: {\n  Numero: num, Date: iso, Client: d['Nom du client'], Telephone: d['Téléphone'] || '',\n  Produit: d['Produit'], Quantite: qte, PrixUnitaire: pu, Total: qte * pu, Statut: 'Impaye'\n} }];"
      },
      "name": "Calculer la commande",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
