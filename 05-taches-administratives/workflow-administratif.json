      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst iso = new Date().toISOString().slice(0, 10);\nconst num = 'DEM-' + iso.replace(/-/g, '') + '-' + String(Math.floor(Math.random() * 9000) + 1000);\nreturn [{ json: {\n  Numero: num, DateDemande: iso, Demandeur: d['Demandeur'], Type: d['Type de demande'],\n  Details: d['Details'] || '', DateSouhaitee: d['Date souhaitee'] || '', Statut: 'En attente'\n} }];"
      },
