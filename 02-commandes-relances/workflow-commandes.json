      "name": "Lire les commandes",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst today = new Date();\nconst days = (r) => Math.floor((today - new Date(r.Date)) / 86400000);\nconst late = rows.filter(r => String(r.Statut || '').toLowerCase().startsWith('impay') && r.Date && days(r) >= 7);\nif (!late.length) return [];\nconst total = late.reduce((s, r) => s + Number(r.Total || 0), 0);\nconst lines = late.map(r => '• ' + r.Numero + ' - ' + r.Client + ' (' + r.Telephone + ') : ' + Number(r.Total).toLocaleString('fr-FR') + ' Ar, ' + days(r) + ' jours');\nreturn [{ json: { message: '⏰ ' + late.length + ' facture(s) impayee(s) a relancer\\nTotal du : ' + total.toLocaleString('fr-FR') + ' Ar\\n\\n' + lines.join('\\n') } }];"
      },
      "name": "Trouver les impayes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        240
      ]
    },
